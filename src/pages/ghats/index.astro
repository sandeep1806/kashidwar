---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContentCard from '../../components/ContentCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import SilkDivider from '../../components/SilkDivider.astro';

const ghats = (await getCollection('ghats')).sort((a, b) => a.data.order - b.data.order);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Ghats', href: '/ghats/' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Famous Ghats of Varanasi',
  itemListElement: ghats.map((ghat, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: ghat.data.name,
    url: `https://kashidwar.com/ghats/${ghat.id}/`,
  })),
};
---

<BaseLayout
  title="Varanasi Ghats Guide: 13 Famous Ghats of Kashi Explained"
  description="A complete Varanasi ghats guide — Dashashwamedh's Ganga aarti, Assi's sunrise, Manikarnika's eternal fire, Namo Ghat's pranam hands and more, with stories and tips."
  breadcrumbs={crumbs}
  jsonLd={[itemListSchema]}
>
  <section class="texture-silk bg-indigo-night pt-10 pb-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Breadcrumbs crumbs={crumbs} tone="dark" />
      <p lang="hi" aria-hidden="true" class="devanagari-gold mt-8 text-3xl">घाट</p>
      <h1 class="font-display mt-2 max-w-3xl text-4xl font-semibold text-cream sm:text-5xl">
        The Ghats of Kashi
      </h1>
      <p class="mt-5 max-w-2xl leading-relaxed text-cream/70">
        Eighty-four ghats stitch the city to the river for nearly seven kilometres — built by
        Maratha queens and Rajput astronomers, sanctified by poets and kings, alive every dawn
        with bathers, wrestlers and boatmen. These are the thirteen to know first: walk them
        south to north and you will have read Banaras cover to cover.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
    <AdSlot position="header-below" />
  </div>

  <section class="texture-paper bg-cream py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {
          ghats.map((ghat, i) => (
            <div class={`reveal reveal-delay-${i % 3}`}>
              <ContentCard
                href={`/ghats/${ghat.id}/`}
                name={ghat.data.name}
                hindiName={ghat.data.hindiName}
                excerpt={ghat.data.excerpt}
                image={ghat.data.image}
                alt={ghat.data.heroAlt}
                meta={ghat.data.significance}
                eager={i < 3}
              />
            </div>
          ))
        }
      </div>

      <SilkDivider class="mt-14" />

      <div class="prose-kashi reveal mx-auto mt-6">
        <h2>Walking the riverfront</h2>
        <p>
          The classic way to meet the ghats is the <strong>dawn boat ride</strong> from
          <a href="/ghats/assi/">Assi</a> to <a href="/ghats/panchganga/">Panchganga</a> — an hour
          of drifting past every facade as the sun lifts out of the far bank, with the bathing
          crowds, temple bells and woodsmoke arriving in that order. Our
          <a href="/tips/">yatra tips</a> cover fair boat prices and timing. On foot, the
          riverfront walkway connects nearly everything: south of
          <a href="/ghats/dashashwamedh/">Dashashwamedh</a> the steps are calmer and local;
          north of it the lanes grow older and denser until they reach the fires of
          <a href="/ghats/manikarnika/">Manikarnika</a>. Time your visit to
          <a href="/festivals/dev-deepawali/">Dev Deepawali</a> and you'll see all eighty-four
          ghats wearing a million diyas at once.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
