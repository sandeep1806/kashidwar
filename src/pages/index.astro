---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContentCard from '../components/ContentCard.astro';
import SilkDivider from '../components/SilkDivider.astro';
import AdSlot from '../components/AdSlot.astro';

const ghats = (await getCollection('ghats')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const mandirs = (await getCollection('mandirs')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const khana = (await getCollection('khana')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const festivals = (await getCollection('festivals')).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
---

<BaseLayout
  title="Kashi Dwar — Varanasi Travel Guide: Ghats, Temples, Food"
  description="Your doorway to Varanasi — a lovingly written guide to Kashi's ghats, temples, Banarasi food, festivals and yatra tips, from the Ganga aarti to Dev Deepawali."
>
  <Hero />

  {/* ---- Mahadev ki Nagri — the city belongs to Shiva, say it first ---- */}
  <section class="texture-silk relative overflow-hidden bg-indigo-deep py-20">
    <div
      lang="hi"
      aria-hidden="true"
      class="watermark-om devanagari pointer-events-none absolute -top-8 -left-4 text-[10rem] leading-none text-gold select-none"
    >
      ॐ
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <figure class="reveal card-diya overflow-hidden rounded-2xl">
        <img
          src="/images/mahadev-shiva-ganga-640.webp"
          srcset="/images/mahadev-shiva-ganga-640.webp 640w, /images/mahadev-shiva-ganga-1280.webp 1280w"
          sizes="(min-width: 1024px) 560px, 100vw"
          alt="Statue of Lord Shiva meditating on the banks of the Ganga"
          width="1280"
          height="960"
          loading="lazy"
          decoding="async"
          class="card-img h-full w-full object-cover"
        />
      </figure>
      <div class="reveal reveal-delay-1">
        <p class="text-xs font-semibold tracking-[0.3em] text-gold-light uppercase">
          Mahadev ki Nagri
        </p>
        <p lang="hi" class="devanagari-gold mt-2 text-4xl sm:text-5xl">महादेव की नगरी</p>
        <h2 class="font-display mt-3 text-3xl font-semibold text-cream sm:text-4xl">
          The City That Belongs to Shiva
        </h2>
        <p class="mt-5 leading-relaxed text-cream/75">
          Kashi is not a city that worships Mahadev — it is Mahadev's own home. The
          tradition says he never leaves: not in flood, not in famine, not even when the
          universe dissolves. Every lane ends at a linga, every morning begins with
          <em>Har Har Mahadev</em>, and the Ganga herself flows out of his hair. To visit
          Kashi is to be his houseguest.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/mandir/kashi-vishwanath/"
            class="rounded-full bg-saffron px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-saffron/30 transition hover:bg-gold"
          >
            Kashi Vishwanath Darshan
          </a>
          <a
            href="/festivals/mahashivratri/"
            class="rounded-full border border-gold/50 px-6 py-3 text-sm font-semibold text-gold-light transition hover:bg-gold/10"
          >
            Mahashivratri in Kashi
          </a>
        </div>
        <p class="mt-6 text-sm tracking-wide text-gold/70">
          <span lang="hi" class="devanagari">हर हर महादेव</span>
          <span class="mx-1.5 text-gold/40">·</span>Har Har Mahadev 🙏
        </p>
      </div>
    </div>
  </section>

  {/* ---- Ghats preview (light / morning) ---- */}
  <section class="texture-paper bg-cream py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="reveal text-center">
        <p lang="hi" aria-hidden="true" class="devanagari text-2xl text-gold">घाट <span lang="en" class="font-body text-xs tracking-[0.3em] text-gold/70 uppercase">Ghats</span></p>
        <h2 class="font-display mt-2 text-3xl font-semibold text-maroon sm:text-4xl">
          The Ghats of Kashi
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-maroon-deep/70">
          Eighty-four stone stairways step down to the Ganga, and every one is a story —
          of kings and poets, of aarti fire and morning mist, of life and what comes after.
          Start with the twelve every yatri should know.
        </p>
      </div>
      <div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {
          ghats.map((ghat, i) => (
            <div class={`reveal reveal-delay-${i}`}>
              <ContentCard
                href={`/ghats/${ghat.id}/`}
                name={ghat.data.name}
                hindiName={ghat.data.hindiName}
                excerpt={ghat.data.excerpt}
                image={ghat.data.image}
                alt={ghat.data.heroAlt}
              />
            </div>
          ))
        }
      </div>
      <p class="reveal mt-10 text-center">
        <a
          href="/ghats/"
          class="inline-block rounded-full border border-saffron/50 px-6 py-2.5 text-sm font-semibold text-saffron transition hover:bg-saffron hover:text-white"
        >
          All twelve ghats →
        </a>
      </p>
    </div>
  </section>

  <SilkDivider />

  {/* in-content ad slot — reserved space, no CLS */}
  <div class="mx-auto max-w-6xl px-4 pb-4 sm:px-6">
    <AdSlot position="in-content" />
  </div>

  {/* ---- Mandir preview (dark / night aarti) ---- */}
  <section class="texture-silk bg-indigo-night py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="reveal text-center">
        <p lang="hi" aria-hidden="true" class="devanagari watermark-om text-2xl text-gold">ॐ नमः शिवाय <span lang="en" class="font-body text-xs tracking-[0.3em] text-gold/70 uppercase">Om Namah Shivaya</span></p>
        <h2 class="font-display mt-2 text-3xl font-semibold text-cream sm:text-4xl">
          Mandir Darshan
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-cream/65">
          The Lord of the Universe keeps his address here, with the goddess of food next door
          and a fierce kotwal keeping order. Timings, queue wisdom and the stories behind
          six essential temples.
        </p>
      </div>
      <div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {
          mandirs.map((mandir, i) => (
            <div class={`reveal reveal-delay-${i}`}>
              <ContentCard
                href={`/mandir/${mandir.id}/`}
                name={mandir.data.name}
                hindiName={mandir.data.hindiName}
                excerpt={mandir.data.excerpt}
                image={mandir.data.image}
                alt={mandir.data.heroAlt}
                meta={mandir.data.timings}
                class="bg-indigo-deep/60"
              />
            </div>
          ))
        }
      </div>
      <p class="reveal mt-10 text-center">
        <a
          href="/mandir/"
          class="inline-block rounded-full border border-gold/50 px-6 py-2.5 text-sm font-semibold text-gold-light transition hover:bg-gold/15"
        >
          All mandir guides →
        </a>
      </p>
    </div>
  </section>

  {/* ---- Khana preview (light) ---- */}
  <section class="texture-paper bg-cream py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="reveal text-center">
        <p lang="hi" aria-hidden="true" class="devanagari text-2xl text-gold">खाना <span lang="en" class="font-body text-xs tracking-[0.3em] text-gold/70 uppercase">Khana · Food</span></p>
        <h2 class="font-display mt-2 text-3xl font-semibold text-maroon sm:text-4xl">
          Banarasi Khana
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-maroon-deep/70">
          Kachori at dawn, lassi in a clay kulhad, winter's malaiyo that melts before
          your teeth arrive — in the city of Annapurna, eating well is a religious duty.
        </p>
      </div>
      <div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {
          khana.map((dish, i) => (
            <article class={`card-diya reveal reveal-delay-${i} rounded-xl bg-white/70 p-6 shadow-sm`}>
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display text-xl font-semibold text-maroon">{dish.data.name}</h3>
                <span lang="hi" class="devanagari shrink-0 text-base text-gold">{dish.data.hindiName}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-maroon-deep/70">{dish.data.excerpt}</p>
              <p class="mt-4 text-sm font-medium">
                <a href="/khana/" class="text-gold transition-colors hover:text-saffron">
                  Read the food guide →
                </a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <SilkDivider />

  {/* ---- Festivals preview (dark) ---- */}
  <section class="texture-silk bg-maroon-deep py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="reveal text-center">
        <p lang="hi" aria-hidden="true" class="devanagari text-2xl text-gold-light">उत्सव <span lang="en" class="font-body text-xs tracking-[0.3em] text-gold-light/70 uppercase">Utsav · Festivals</span></p>
        <h2 class="font-display mt-2 text-3xl font-semibold text-cream sm:text-4xl">
          When the City Celebrates
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-cream/70">
          A million diyas on Kartik Purnima. Shiva's wedding procession through the lanes.
          A boy leaping into the Ganga as Krishna. Time your yatra to the festivals and
          Kashi doubles itself.
        </p>
      </div>
      <div class="mt-12 grid gap-7 sm:grid-cols-2">
        {
          festivals.map((festival, i) => (
            <div class={`reveal reveal-delay-${i}`}>
              <ContentCard
                href={`/festivals/${festival.id}/`}
                name={festival.data.name}
                hindiName={festival.data.hindiName}
                excerpt={festival.data.excerpt}
                image={festival.data.image}
                alt={festival.data.heroAlt}
                meta={festival.data.month}
                class="bg-maroon/40"
              />
            </div>
          ))
        }
      </div>
      <p class="reveal mt-10 text-center">
        <a
          href="/festivals/"
          class="inline-block rounded-full border border-gold/50 px-6 py-2.5 text-sm font-semibold text-gold-light transition hover:bg-gold/15"
        >
          The festival calendar →
        </a>
      </p>
    </div>
  </section>

  {/* ---- Tips strip ---- */}
  <section class="bg-cream py-16 text-center">
    <div class="reveal mx-auto max-w-2xl px-4 sm:px-6">
      <h2 class="font-display text-2xl font-semibold text-maroon sm:text-3xl">
        First time in Kashi?
      </h2>
      <p class="mt-3 text-maroon-deep/70">
        Best season, boat-ride bargaining, aarti timings, temple etiquette and what to do
        about the bhang question — our practical guide answers what every yatri asks.
      </p>
      <a
        href="/tips/"
        class="mt-6 inline-block rounded-full bg-saffron px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-saffron/25 transition hover:bg-gold"
      >
        Read the Yatra Tips
      </a>
    </div>
  </section>
</BaseLayout>
