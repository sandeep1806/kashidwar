---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Kashi Dwar | Lost in the Galis"
  description="This page seems to have wandered off into the lanes of Banaras. Find your way back to the ghats, mandirs, food and festivals of Kashi Dwar."
>
  <section class="texture-silk flex min-h-[70vh] flex-col items-center justify-center bg-indigo-night px-4 py-20 text-center">
    <p lang="hi" aria-hidden="true" class="devanagari-gold glow-gold text-6xl">४०४</p>
    <p class="mt-2 text-xs tracking-[0.3em] text-cream/50 uppercase">Error 404</p>
    <h1 class="font-display mt-6 text-3xl font-semibold text-cream sm:text-4xl">
      Lost in the galis
    </h1>
    <p class="mt-4 max-w-md leading-relaxed text-cream/70">
      Even lifelong Banarasis get gloriously lost in these lanes — it's considered part of
      the pilgrimage. The page you wanted isn't here, but the river is always that way.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-saffron px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-saffron/30 transition hover:bg-gold"
      >
        Back to the Dwar
      </a>
      <a
        href="/ghats/"
        class="rounded-full border border-gold/50 px-6 py-3 text-sm font-semibold text-gold-light transition hover:bg-gold/10"
      >
        Walk the Ghats
      </a>
    </div>
  </section>
</BaseLayout>
