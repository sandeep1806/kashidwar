---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AdSlot from '../../components/AdSlot.astro';
import SilkDivider from '../../components/SilkDivider.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';

export async function getStaticPaths() {
  const mandirs = await getCollection('mandirs');
  return mandirs.map((mandir) => ({ params: { slug: mandir.id }, props: { mandir } }));
}

const { mandir } = Astro.props;
const { Content } = await render(mandir);
const d = mandir.data;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Mandir', href: '/mandir' },
  { name: d.name, href: `/mandir/${mandir.id}` },
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'HinduTemple'],
  name: d.name,
  alternateName: d.hindiName,
  description: d.description,
  url: `https://kashidwar.com/mandir/${mandir.id}`,
  image: `https://kashidwar.com/images/${d.image}-1280.webp`,
  geo: { '@type': 'GeoCoordinates', latitude: d.lat, longitude: d.lng },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Varanasi',
    addressRegion: 'Uttar Pradesh',
    addressCountry: 'IN',
  },
  touristType: ['Pilgrims', 'Cultural travellers'],
  isAccessibleForFree: true,
};

const facts = [
  { label: 'Deity', value: d.deity },
  { label: 'Timings', value: d.timings },
  ...(d.aartiTimings ? [{ label: 'Aarti', value: d.aartiTimings }] : []),
  { label: 'Entry & queue tips', value: d.entryTips },
  { label: 'Dress code', value: d.dressCode },
];
---

<BaseLayout
  title={d.title}
  description={d.description}
  ogType="article"
  ogImage={`/images/${d.image}-1280.webp`}
  breadcrumbs={crumbs}
  jsonLd={[attractionSchema]}
>
  <PageHero
    title={d.name}
    hindiName={d.hindiName}
    kicker="Mandir Darshan"
    image={d.image}
    alt={d.heroAlt}
    crumbs={crumbs}
  />

  <div class="texture-paper bg-cream">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_300px]">
      <div>
        {/* darshan facts */}
        <div class="reveal card-diya rounded-xl bg-white/70 p-6">
          <h2 class="font-display text-xl font-semibold text-maroon">Darshan at a glance</h2>
          <dl class="mt-4 space-y-3">
            {
              facts.map((fact) => (
                <div class="grid gap-1 sm:grid-cols-[160px_1fr] sm:gap-4">
                  <dt class="text-xs font-semibold tracking-[0.15em] text-saffron uppercase">
                    {fact.label}
                  </dt>
                  <dd class="text-sm leading-relaxed text-maroon-deep/80">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 border-t border-gold/20 pt-3 text-xs text-maroon-deep/50">
            Timings shift with seasons and festivals — reconfirm locally or on official channels
            before a special trip.
          </p>
        </div>

        <article class="prose-kashi reveal mt-10">
          <Content />
        </article>

        <div class="mt-10">
          <AdSlot position="in-content" />
        </div>

        <SilkDivider class="mt-10" />

        <RelatedLinks
          ghats={d.relatedGhats}
          mandirs={d.relatedMandirs}
          festivals={d.relatedFestivals}
        />
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <AdSlot position="sidebar" />
          <nav class="card-diya rounded-xl bg-white/70 p-5" aria-label="Continue exploring">
            <h2 class="text-xs font-semibold tracking-[0.18em] text-saffron uppercase">Plan the day</h2>
            <ul class="mt-3 space-y-2 text-sm">
              <li><a class="text-maroon transition hover:text-saffron" href="/mandir">← All mandir guides</a></li>
              <li><a class="text-maroon transition hover:text-saffron" href="/tips">Etiquette & aarti timings</a></li>
              <li><a class="text-maroon transition hover:text-saffron" href="/festivals">Festival calendar</a></li>
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
