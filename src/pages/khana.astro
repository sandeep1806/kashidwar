---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import SilkDivider from '../components/SilkDivider.astro';

const dishes = (await getCollection('khana')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  dishes.map(async (dish) => ({ dish, Content: (await render(dish)).Content }))
);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Khana', href: '/khana/' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Banarasi Food Guide — what to eat in Varanasi',
  itemListElement: dishes.map((dish, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: dish.data.name,
    url: `https://kashidwar.com/khana/#${dish.id}`,
  })),
};
---

<BaseLayout
  title="Banarasi Food Guide: Kachori, Lassi, Malaiyo, Paan & More"
  description="A Banarasi food guide written by appetite — kachori-sabzi breakfasts, the Blue Lassi, winter's malaiyo, baati chokha, the perfect paan and thandai, with where-to-eat tips."
  breadcrumbs={crumbs}
  jsonLd={[itemListSchema]}
>
  <section class="relative isolate overflow-hidden bg-indigo-night">
    <img
      src="/images/varanasi-riverside-market-1280.webp"
      srcset="/images/varanasi-riverside-market-640.webp 640w, /images/varanasi-riverside-market-1280.webp 1280w"
      sizes="100vw"
      alt="A crowded Varanasi market street near the river with colorful umbrellas"
      width="1280"
      height="800"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-indigo-deep via-indigo-night/55 to-indigo-night/25" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-24 pb-12 sm:px-6 sm:pt-32 sm:pb-16">
      <Breadcrumbs crumbs={crumbs} tone="dark" />
      <p lang="hi" aria-hidden="true" class="devanagari-gold mt-6 text-3xl">खाना</p>
      <h1 class="font-display mt-2 max-w-3xl text-4xl font-semibold text-cream sm:text-5xl">
        The Banarasi Food Guide
      </h1>
      <p class="mt-5 max-w-2xl leading-relaxed text-cream/80">
        This is Annapurna's city — the goddess of food herself keeps house here, and Banaras
        treats eating as a devotional practice with excellent production values. Six things
        you must eat, where the locals actually eat them, and the etiquette of each.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
    <AdSlot position="header-below" />
  </div>

  <div class="texture-paper bg-cream py-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      {/* quick nav */}
      <nav class="reveal flex flex-wrap gap-2" aria-label="Dishes on this page">
        {
          dishes.map((dish) => (
            <a
              href={`#${dish.id}`}
              class="rounded-full border border-gold/40 px-4 py-1.5 text-sm font-medium text-maroon transition hover:border-gold hover:bg-gold/10"
            >
              {dish.data.name}
            </a>
          ))
        }
      </nav>

      <div class="mt-12 space-y-12">
        {
          rendered.map(({ dish, Content }, i) => (
            <>
              <section id={dish.id} class="reveal scroll-mt-24" aria-labelledby={`${dish.id}-h`}>
                <div class="card-diya rounded-2xl bg-white/70 p-7 sm:p-9">
                  <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h2 id={`${dish.id}-h`} class="font-display text-3xl font-semibold text-maroon">
                      {dish.data.name}
                    </h2>
                    <span lang="hi" class="devanagari text-xl text-gold">{dish.data.hindiName}</span>
                  </div>
                  <div class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
                    <p class="rounded-lg bg-cream/80 px-4 py-2.5 text-maroon-deep/80">
                      <strong class="text-saffron">Where:</strong> {dish.data.whereToTry}
                    </p>
                    <p class="rounded-lg bg-cream/80 px-4 py-2.5 text-maroon-deep/80">
                      <strong class="text-saffron">When:</strong> {dish.data.bestTime}
                    </p>
                  </div>
                  <div class="prose-kashi mt-6 max-w-none">
                    <Content />
                  </div>
                </div>
              </section>
              {i === 2 && (
                <div>
                  <AdSlot position="in-content" />
                </div>
              )}
            </>
          ))
        }
      </div>

      <SilkDivider class="mt-14" />

      <div class="prose-kashi reveal mx-auto mt-4">
        <h2>Eating well, eating safe</h2>
        <p>
          Banarasi street food has fed pilgrims for centuries and knows its business: pick
          stalls that are <strong>busy and frying fresh</strong>, eat hot things hot, prefer
          kulhad over glass, and let your stomach acclimatise for a day before the full
          syllabus. Most of the old city's classics are pure vegetarian — this is a temple
          town to its bones. Pair the food trail with the
          <a href="/ghats/">ghats</a> it lives beside, and if your trip lands in winter,
          plan mornings around malaiyo and evenings around
          <a href="/festivals/dev-deepawali/">Dev Deepawali</a>. Annapurna looks after the rest.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
