---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Crumb {
  name: string;
  href: string;
}

interface Alternate {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  breadcrumbs?: Crumb[];
  jsonLd?: object[];
  lang?: 'en' | 'hi' | 'ta' | 'te';
  alternates?: Alternate[];
}

const {
  title,
  description,
  ogType,
  ogImage,
  breadcrumbs,
  jsonLd,
  lang = 'en',
  alternates,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1a1a3e" />

    {/* Google Analytics 4 — loads on every page; enhanced measurement tracks
        Astro view-transition (History API) navigations automatically */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-G6VN84753L"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-G6VN84753L');
    </script>

    <Seo
      title={title}
      description={description}
      ogType={ogType}
      ogImage={ogImage}
      breadcrumbs={breadcrumbs}
      jsonLd={jsonLd}
      lang={lang}
      alternates={alternates}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Tiro+Devanagari+Hindi&family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
    {/* Tamil & Telugu faces load only on those locales' pages */}
    {
      lang === 'ta' && (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400;500;600&display=swap"
        />
      )
    }
    {
      lang === 'te' && (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Noto+Sans+Telugu:wght@400;500;600&display=swap"
        />
      )
    }

    <ClientRouter />
  </head>
  <body class="min-h-screen">
    {/* saffron light sweep shown during view transitions */}
    <div class="sweep-light" aria-hidden="true"></div>

    {/* golden Ganga flow line — draws itself as you scroll */}
    <div class="ganga-flow hidden lg:block" aria-hidden="true">
      <div class="flow-track"></div>
      <div class="flow-fill"></div>
    </div>

    <Nav lang={lang} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <script src="../scripts/site.js"></script>
  </body>
</html>
