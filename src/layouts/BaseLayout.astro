---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  breadcrumbs?: Crumb[];
  jsonLd?: object[];
}

const { title, description, ogType, ogImage, breadcrumbs, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1a1a3e" />

    <Seo
      title={title}
      description={description}
      ogType={ogType}
      ogImage={ogImage}
      breadcrumbs={breadcrumbs}
      jsonLd={jsonLd}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Tiro+Devanagari+Hindi&family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
    />

    <ClientRouter />
  </head>
  <body class="min-h-screen">
    {/* saffron light sweep shown during view transitions */}
    <div class="sweep-light" aria-hidden="true"></div>

    {/* golden Ganga flow line — draws itself as you scroll */}
    <div class="ganga-flow hidden lg:block" aria-hidden="true">
      <div class="flow-track"></div>
      <div class="flow-fill"></div>
    </div>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/site.js"></script>
  </body>
</html>
