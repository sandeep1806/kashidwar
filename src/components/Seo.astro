---
/**
 * Every page gets: unique title + description, canonical, OG + Twitter cards,
 * WebSite + BreadcrumbList JSON-LD, plus any page-specific schema passed in.
 * See CLAUDE.md › SEO Rules.
 */
interface Crumb {
  name: string;
  href: string;
}

interface Alternate {
  hreflang: string;
  href: string; // site-absolute path, e.g. /hi/map/
}

interface Props {
  title: string; // 50-60 chars, unique per page
  description: string; // 150-160 chars, unique per page
  ogType?: string;
  ogImage?: string;
  breadcrumbs?: Crumb[];
  jsonLd?: object[]; // page-specific schema (TouristAttraction, Event, FAQPage...)
  lang?: string;
  alternates?: Alternate[]; // localized variants → real hreflang set
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og-default.jpg',
  breadcrumbs = [],
  jsonLd = [],
  lang = 'en',
  alternates,
} = Astro.props;

const site = Astro.site ?? new URL('https://kashidwar.com');
// Canonical form on Cloudflare Pages is WITH trailing slash (matches 308s)
const withSlash = (p: string) => (p.endsWith('/') || /\.[a-z0-9]+$/i.test(p) ? p : p + '/');
const canonical = new URL(withSlash(Astro.url.pathname), site).href;
const ogImageUrl = new URL(ogImage, site).href;

const ogLocaleMap: Record<string, string> = {
  en: 'en_IN',
  hi: 'hi_IN',
  ta: 'ta_IN',
  te: 'te_IN',
};
const ogLocale = ogLocaleMap[lang] ?? 'en_IN';

// When a page provides localized variants, emit the real hreflang set;
// otherwise fall back to the single-language self-reference.
const hreflangs =
  alternates && alternates.length
    ? alternates.map((a) => ({ hreflang: a.hreflang, href: new URL(a.href, site).href }))
    : [
        { hreflang: 'en', href: canonical },
        { hreflang: 'x-default', href: canonical },
      ];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Kashi Dwar',
  alternateName: 'काशी द्वार',
  url: site.href,
  description:
    'Kashi Dwar is a lovingly written guide to Varanasi — its ghats, temples, food, festivals and travel wisdom.',
  inLanguage: 'en',
};

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: new URL(withSlash(crumb.href), site).href,
        })),
      }
    : null;

const schemas = [websiteSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...jsonLd];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{hreflangs.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Kashi Dwar" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content={ogLocale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
