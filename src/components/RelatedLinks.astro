---
/**
 * Internal-linking block (SEO): resolves related slugs from frontmatter into
 * named links across ghats / mandirs / festivals. See CLAUDE.md › SEO Rules #4.
 */
import { getCollection } from 'astro:content';

interface Props {
  ghats?: string[];
  mandirs?: string[];
  festivals?: string[];
}

const { ghats = [], mandirs = [], festivals = [] } = Astro.props;

const [allGhats, allMandirs, allFestivals] = await Promise.all([
  getCollection('ghats'),
  getCollection('mandirs'),
  getCollection('festivals'),
]);

const resolve = (slugs: string[], collection: { id: string; data: { name: string; excerpt: string } }[], base: string) =>
  slugs
    .map((slug) => collection.find((entry) => entry.id === slug))
    .filter((entry) => entry !== undefined)
    .map((entry) => ({ href: `${base}/${entry.id}/`, name: entry.data.name, excerpt: entry.data.excerpt }));

const groups = [
  { heading: 'Nearby ghats', items: resolve(ghats, allGhats, '/ghats') },
  { heading: 'Mandir nearby', items: resolve(mandirs, allMandirs, '/mandir') },
  { heading: 'Festivals here', items: resolve(festivals, allFestivals, '/festivals') },
].filter((group) => group.items.length > 0);
---

{
  groups.length > 0 && (
    <section class="reveal mt-6" aria-label="Related guides">
      <h2 class="font-display text-2xl font-semibold text-maroon">Continue your yatra</h2>
      <div class="mt-5 grid gap-6 sm:grid-cols-3">
        {groups.map((group) => (
          <div>
            <h3 class="text-xs font-semibold tracking-[0.18em] text-saffron uppercase">
              {group.heading}
            </h3>
            <ul class="mt-3 space-y-3">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="group block">
                    <span class="font-medium text-maroon transition group-hover:text-saffron">
                      {item.name} →
                    </span>
                    <span class="mt-0.5 block text-xs leading-relaxed text-maroon-deep/60">
                      {item.excerpt}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )
}
