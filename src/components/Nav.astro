---
const links = [
  { href: '/ghats', label: 'Ghats', hindi: 'घाट' },
  { href: '/mandir', label: 'Mandir', hindi: 'मंदिर' },
  { href: '/khana', label: 'Khana', hindi: 'खाना' },
  { href: '/festivals', label: 'Festivals', hindi: 'उत्सव' },
  { href: '/tips', label: 'Yatra Tips', hindi: 'यात्रा' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header
  class="sticky top-0 z-40 border-b border-gold/20 bg-indigo-night/95 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
    aria-label="Main"
  >
    <a href="/" class="group flex items-baseline gap-2" aria-label="Kashi Dwar home">
      <span class="devanagari-gold text-2xl leading-none transition group-hover:glow-gold"
        >काशी द्वार</span
      >
      <span class="hidden text-xs font-medium tracking-[0.2em] text-cream/60 uppercase sm:inline"
        >Kashi Dwar</span
      >
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center gap-0.5 text-sm sm:gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-2.5 py-1.5 transition-colors duration-300 sm:px-3.5',
                  isActive(link.href)
                    ? 'bg-gold/15 text-gold-light'
                    : 'text-cream/85 hover:bg-cream/10 hover:text-gold-light',
                ]}
              >
                <span class="hidden md:inline">{link.label}</span>
                <span class="devanagari md:hidden">{link.hindi}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <button
        id="bell-toggle"
        type="button"
        aria-pressed="false"
        title="Toggle temple bell ambience"
        aria-label="Toggle temple bell ambience"
        class="ml-1 rounded-full border border-gold/25 px-2.5 py-1.5 text-sm text-cream/70 transition hover:border-gold/60 hover:text-gold-light [&.is-on]:border-gold [&.is-on]:bg-gold/15 [&.is-on]:text-gold-light"
      >
        🔔
      </button>
    </div>
  </nav>
</header>
