---
// English-first labels: many visitors (South India, international) don't read
// Devanagari — Hindi script is decorative only, never the sole carrier of info.
const links = [
  { href: '/ghats/', label: 'Ghats' },
  { href: '/mandir/', label: 'Mandir' },
  { href: '/khana/', label: 'Khana' },
  { href: '/festivals/', label: 'Festivals' },
  { href: '/tips/', label: 'Tips' },
];

// hrefs end with '/' so startsWith also matches child routes (/ghats/assi/)
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const isActive = (href: string) => current.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b border-gold/20 bg-indigo-night/95 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
    aria-label="Main"
  >
    <a href="/" class="group flex items-baseline gap-2" aria-label="Kashi Dwar home">
      <span lang="hi" class="devanagari-gold text-xl transition group-hover:glow-gold sm:text-2xl"
        >काशी द्वार</span
      >
      <span class="hidden text-xs font-medium tracking-[0.2em] text-cream/60 uppercase md:inline"
        >Kashi Dwar</span
      >
    </a>

    <div class="flex min-w-0 items-center gap-1 sm:gap-2">
      <ul class="no-scrollbar flex items-center gap-0.5 overflow-x-auto text-xs whitespace-nowrap sm:gap-1 sm:text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-2 py-1.5 transition-colors duration-300 sm:px-3.5',
                  isActive(link.href)
                    ? 'bg-gold/15 text-gold-light'
                    : 'text-cream/85 hover:bg-cream/10 hover:text-gold-light',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        id="bell-toggle"
        type="button"
        aria-pressed="false"
        title="Toggle temple bell ambience"
        aria-label="Toggle temple bell ambience"
        class="ml-1 rounded-full border border-gold/25 px-2.5 py-1.5 text-sm text-cream/70 transition hover:border-gold/60 hover:text-gold-light [&.is-on]:border-gold [&.is-on]:bg-gold/15 [&.is-on]:text-gold-light"
      >
        🔔
      </button>
    </div>
  </nav>
</header>
