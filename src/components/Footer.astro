---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Explore',
    links: [
      { href: '/ghats', label: 'Ghats of Kashi' },
      { href: '/mandir', label: 'Mandir Darshan' },
      { href: '/khana', label: 'Banarasi Khana' },
      { href: '/festivals', label: 'Festivals' },
    ],
  },
  {
    heading: 'Plan',
    links: [
      { href: '/tips', label: 'Yatra Tips' },
      { href: '/ghats/dashashwamedh', label: 'Ganga Aarti Guide' },
      { href: '/mandir/kashi-vishwanath', label: 'Vishwanath Darshan' },
      { href: '/festivals/dev-deepawali', label: 'Dev Deepawali' },
    ],
  },
  {
    heading: 'Kashi Dwar',
    links: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
      { href: '/privacy', label: 'Privacy Policy' },
    ],
  },
];
---

<footer class="texture-silk relative overflow-hidden bg-indigo-deep text-cream/80">
  {/* slow-pulsing sacred watermark */}
  <div
    aria-hidden="true"
    class="watermark-om devanagari pointer-events-none absolute -right-6 -bottom-10 text-[11rem] leading-none text-gold select-none"
  >
    ॐ
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="devanagari-gold text-3xl">काशी द्वार</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-cream/60">
          आपका द्वार काशी की ओर — your doorway to the eternal city. Written with
          love, one ghat at a time.
        </p>
        <p class="devanagari mt-5 text-sm tracking-wide text-gold/70">हर हर महादेव 🙏</p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.heading}>
            <h2 class="text-xs font-semibold tracking-[0.2em] text-gold/80 uppercase">
              {col.heading}
            </h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-cream/70 transition-colors duration-300 hover:text-gold-light"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-gold/15 pt-6 text-xs text-cream/50 sm:flex-row"
    >
      <p>© {year} Kashi Dwar · kashidwar.com</p>
      <p class="devanagari text-gold/60">ॐ नमः शिवाय</p>
    </div>
  </div>
</footer>
