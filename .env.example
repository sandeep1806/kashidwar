# Map tiles (optional). Default is OpenStreetMap darkened with CSS.
# For CartoDB Dark Matter (DESIGN.md), get a CARTO API key and set:
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY"
# NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"
# NEXT_PUBLIC_MAP_TILES_ARE_DARK=1
