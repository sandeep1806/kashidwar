{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kashidwar",
  // worker.js wraps .open-next/worker.js and adds the weekly rebuild cron.
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Apex only. www.kashidwar.com is a zone Redirect Rule (301 → apex) and
  // keeps its own proxied DNS record; it is deliberately not attached here.
  "routes": [
    { "pattern": "kashidwar.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kashidwar"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": { "enabled": true },
  // Weekly rebuild (Mondays 00:30 UTC = 06:00 IST) so festival pages roll over
  // to the next occurrence: worker.js calls the DEPLOY_HOOK_URL secret.
  "triggers": { "crons": ["30 0 * * 1"] },
  "vars": {
    // Public origin of the site. Used for canonical URLs, hreflang, sitemap,
    // robots, OpenGraph and JSON-LD. scripts/cf-build.mjs injects it into
    // `next build` (the prerendered pages bake it in); a build-environment
    // variable of the same name (Workers Builds) takes precedence.
    "NEXT_PUBLIC_SITE_URL": "https://kashidwar.com",
    // "on" once Cloudflare Images (transformations) is enabled on the zone;
    // "off" serves photos as-is through next/image's custom loader.
    "NEXT_PUBLIC_IMAGE_OPTIMIZATION": "off"
  }
}
